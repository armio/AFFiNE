# =============================================================================
# AFFiNE self-hosted + Cloudflare — variables de entorno
#
#   cp .env.example .env && chmod 600 .env
#
# Rellena los valores marcados como OBLIGATORIO. No subas .env a git.
# Tras cualquier cambio: docker compose up -d   (regenera config/config.json)
# =============================================================================

# --- Versiones (fijadas; súbelas a mano tras leer las notas de versión) ------
AFFINE_REVISION=0.27.4
CLOUDFLARED_VERSION=2026.11.1
PGVECTOR_TAG=0.8.7-pg16
REDIS_TAG=7.4-alpine

# --- Dominio público ----------------------------------------------------------
# Hostname del "published application route" del Tunnel. Solo el hostname.
AFFINE_DOMAIN=affine.ddoblee.com
AFFINE_SERVER_NAME="AFFiNE DDOBLEE"

# --- Postgres (local, no expuesto) --------------------------------------------
DB_USERNAME=affine
DB_DATABASE=affine
# OBLIGATORIO. Solo letras y números (va dentro de una URL): openssl rand -hex 24
DB_PASSWORD=

# --- Cloudflare Tunnel ----------------------------------------------------------
# OBLIGATORIO. Networking > Tunnels > (tu tunnel) > Add a replica > el valor eyJ...
CLOUDFLARE_TUNNEL_TOKEN=

# --- Cloudflare R2: archivos de AFFiNE ------------------------------------------
# r2 (recomendado) o local (guarda en ./data/storage; solo para pruebas)
AFFINE_STORAGE=r2
# OBLIGATORIO. ID de cuenta de Cloudflare (32 caracteres hex)
R2_ACCOUNT_ID=
# default o eu (debe coincidir con la jurisdicción de los buckets)
R2_JURISDICTION=default
# OBLIGATORIO. Token de R2 "Object Read & Write" limitado a los 3 buckets de abajo
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_BLOBS=affine-blobs
R2_BUCKET_AVATARS=affine-avatars
R2_BUCKET_COPILOT=affine-copilot
# OBLIGATORIO. Firma las URLs de subida que AFFiNE entrega al navegador: openssl rand -hex 32
AFFINE_UPLOAD_SIGN_KEY=

# --- Correo saliente (SMTP) -----------------------------------------------------
# Opción A (por defecto): Resend, con ddoblee.com ya verificado en tu cuenta.
#   MAILER_PASSWORD = API key de Resend con permiso "Sending access" para ddoblee.com
MAILER_HOST=smtp.resend.com
MAILER_PORT=465
MAILER_USER=resend
MAILER_PASSWORD=
MAILER_SENDER="AFFiNE DDOBLEE <affine@ddoblee.com>"
# Opción B: Cloudflare Email Service (beta; requiere dar de alta el dominio en Email Sending)
#   MAILER_HOST=smtp.mx.cloudflare.net
#   MAILER_PORT=465
#   MAILER_USER=api_token
#   MAILER_PASSWORD=<API token de Cloudflare con permiso "Email Sending: Edit">

# --- Cuentas y funciones --------------------------------------------------------
# false = solo el admin crea cuentas (recomendado para un equipo cerrado)
AFFINE_ALLOW_SIGNUP=false
# IA de AFFiNE (requiere configurar proveedores en /admin). Desactivada por defecto.
AFFINE_COPILOT_ENABLED=false

# --- Backups de Postgres a R2 ---------------------------------------------------
BACKUP_BUCKET=affine-backups
# Hora diaria en UTC (07:00 UTC = 3:00 AM en Puerto Rico)
BACKUP_TIME=07:00
# OBLIGATORIO. Token de R2 "Object Read & Write" limitado SOLO al bucket de backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Opcional: endpoint S3 distinto (p. ej. buckets en la jurisdicción EU)
# BACKUP_R2_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
